.UIPanel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.UIPanelMainMenu {
    background-color: rgb(35, 116, 160);
    width: 600px;
    height: 430px;
    padding: 5px;
}

.UIPanelMainMenuArea {
    background-color: rgb(0, 200, 255);
    padding: 0;
    margin: 5px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.UIPanelMainMenuButton {
    background-color: rgb(0, 200, 255);
    padding: 0;
    margin: 5px;
    min-height: 50px;
    -unity-text-align: middle-center;
}

.MenuListRow {
    background-color: rgb(0, 200, 255);
    padding: 0;
    margin: 0;
    height: 50px;
    flex-direction: row;
}

.MenuListCol {
    padding: 0;
    margin: 0;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    -unity-text-align: middle-left;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.MenuListItemControlsPressKey {
    background-color: rgb(0, 200, 255);
    position: absolute;
    padding: 0;
    margin: 5px;
    -unity-text-align: middle-center;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.TargetPoint {
    margin: 0;
    padding: 0;
    background-image: url("project://database/Assets/Resources/UI/Hud/TargetPoint.png?fileID=2800000&guid=a07fcd804f1abb0459f682e82c778537&type=3#TargetPoint");
    width: 50px;
    height: 50px;
    position: absolute;
}

.ActionInfo {
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-center;
    position: absolute;
    padding-top: 100px;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-direction: row;
}

.InventoryPanel {
    background-color: rgb(35, 116, 160);
    width: 610px;
    padding: 5px;
    flex-wrap: wrap;
    flex-direction: row;
}

.EquipmentPanel {
    background-color: rgb(35, 116, 160);
    width: 610px;
    padding: 5px;
    flex-wrap: wrap;
    flex-direction: row;
    position: absolute;
    bottom: 10px;
}

.InventoryItem {
    background-color: rgb(0, 180, 235);
    margin: 5px;
    width: 50px;
    height: 50px;
    flex-basis: 50px;
}

.InventoryItemActive {
    background-color: rgb(180, 180, 235);
    margin: 5px;
    width: 50px;
    height: 50px;
    flex-basis: 50px;
}

.unity-button {
    border-width: 0;
}

.unity-scroller {
    background-color: rgb(0, 180, 235);
    border-width: 0;
}

.unity-repeat-button {
    background-color: rgb(0, 180, 235);
    border-width: 0;
}

.unity-base-field__input {
    margin: 0;
}

.unity-base-slider__tracker {
    background-color: rgb(0, 160, 215);
    border-width: 0;
}

.unity-base-slider__dragger {
    background-color: rgb(0, 180, 235);
    border-width: 0;
}

.unity-list-view {
    flex-grow: 1;
}

.unity-list-view__empty-label {
    display: none;
}

.unity-collection-view__item {
    justify-content: center;
    align-items: flex-start;
}

.unity-collection-view__item:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(0, 200, 255);
}

.unity-collection-view__item--selected {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

.unity-collection-view__item--selected:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}
